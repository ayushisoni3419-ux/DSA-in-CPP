#include<iostream>
#include<stack>
using namespace std;

bool isValid(string s)
{
    stack<char> st;

    for(char ch : s)
    {
        // Opening brackets
        if(ch == '(' || ch == '{' || ch == '[')
        {
            st.push(ch);
        }
        // Closing brackets
        else
        {
            if(st.empty())
                return false;

            if((ch == ')' && st.top() == '(') ||
               (ch == '}' && st.top() == '{') ||
               (ch == ']' && st.top() == '['))
            {
                st.pop();
            }
            else
            {
                return false;
            }
        }
    }

    return st.empty();
}

int main()
{
    string s;

    cout << "Enter the string: ";
    cin >> s;

    if(isValid(s))
        cout << "Valid";
    else
        cout << "Invalid";

    return 0;
}