#include <iostream>
using namespace std;

class Stack {
private:
    int arr[100];
    int top;

public:
    // Constructor
    Stack() {
        top = -1;
    }

    // Push an element onto the stack
    void push(int value) {
        if (top == 99) {
            cout << "Stack Overflow!" << endl;
            return;
        }
        arr[++top] = value;
    }

    // Pop the top element
    void pop() {
        if (top == -1) {
            cout << "Stack Underflow!" << endl;
            return;
        }
        top--;
    }

    // Return the top element
    int peek() {
        if (top == -1) {
            cout << "Stack is Empty!" << endl;
            return -1;
        }
        return arr[top];
    }

    // Check if stack is empty
    bool isEmpty() {
        return top == -1;
    }

    // Return current size of stack
    int size() {
        return top + 1;
    }

    // Display stack elements
    void display() {
        if (isEmpty()) {
            cout << "Stack is Empty!" << endl;
            return;
        }

        cout << "Stack Elements (Top to Bottom): ";
        for (int i = top; i >= 0; i--) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }
};

int main() {
    Stack st;

    st.push(10);
    st.push(20);
    st.push(30);

    st.display();

    cout << "Top Element: " << st.peek() << endl;
    cout << "Stack Size: " << st.size() << endl;

    st.pop();

    cout << "\nAfter Pop:" << endl;
    st.display();

    return 0;
}